# Copy to .env (git-ignored) and fill in. Never commit real values.

# Mailchimp API key, from Account > Extras > API keys. Format: <32 hex chars>-<server>. Full account access, use a sandbox account.
MAILCHIMP_API_KEY=your-api-key-us19
# Data center prefix, the part after the dash in the key (for example us19).
MAILCHIMP_SERVER=us19
# Sandbox audience ID, from Audience > Settings > Audience name and defaults. Used by integration tests only.
MAILCHIMP_LIST_ID=your-audience-id
# Optional: domain of the kestra-it-<uuid>@<domain> test addresses (default example.com). Set only if Mailchimp rejects the default.
# MAILCHIMP_TEST_EMAIL_DOMAIN=your-domain.example
# Optional: ID of a campaign that was already sent, used by report integration tests.
MAILCHIMP_CAMPAIGN_ID=
# Optional: OAuth access token (never expires); only for testing the OAuth path.
MAILCHIMP_OAUTH_TOKEN=

# Base64 of MAILCHIMP_API_KEY WITHOUT a trailing newline: printf '%s' "$MAILCHIMP_API_KEY" | base64
# (echo adds a newline that breaks the key). Read in flows via {{ secret('MAILCHIMP_API_KEY') }}; docker compose loads .env into Kestra.
SECRET_MAILCHIMP_API_KEY=
